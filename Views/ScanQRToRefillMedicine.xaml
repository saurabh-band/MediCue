<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MediCue.Views.ScanQRToRefillMedicine"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    Style="{StaticResource ShellPageWithoutTabBarStyle}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="0.8*,0.2*">
            <Label
                Grid.Column="0"
                Style="{StaticResource PageTitleLabelstyle}"
                Text="Refilli Medicicine Stock" />
        </Grid>
    </Shell.TitleView>
    <Grid
        Padding="16"
        RowDefinitions="*, Auto, Auto"
        RowSpacing="12">
        <Grid
            BackgroundColor="Red"
            HeightRequest="300"
            WidthRequest="300">
            <zxing:CameraBarcodeReaderView BarcodesDetected="OnBarcodesDetected" />
        </Grid>
        <Border
            Grid.Row="1"
            Padding="12"
            BackgroundColor="{StaticResource greyBackgroundColor}">
            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Medicine Details:" />
                <Label
                    x:Name="ScannedTextLabel"
                    LineBreakMode="WordWrap"
                    Text="" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2">
            <Button Text="Save" />
        </Grid>

    </Grid>
</ContentPage>